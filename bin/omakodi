#!/usr/bin/env -S python3 -I
"""Entry point. Finds lib/ next to the real file, even when called through a link."""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))

from omakodi.cli import main  # noqa: E402

sys.exit(main())
