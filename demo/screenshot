#!/usr/bin/env bash
# Takes preview.png from the live Omarchy shell against the fake Kodi:
#
#   demo/run -- demo/screenshot [OUT.png]
#   OMAKODI_DEMO_FULL=FILE.png   also capture the whole monitor
#
# What it changes, and puts back on exit, failure or interruption:
# - ~/.config/omarchy/shell.json: backed up, replaced by the same file with a
#   plain demo bar (menu, workspaces, clock, omakodi with its title, audio,
#   power), restored byte for byte;
# - the shell: restarted with OMAKODI_CONFIG pointing at the fake, then
#   restarted normally (`omarchy-restart-shell`); the bar blinks twice;
# - the workspace: an empty one for the shot, then the one you were on.
# The real omakodi config and the real Kodi are never touched.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="${1:-$root/preview.png}"
plugin="io.github.frestina.omakodi"
title="Harbour Lights"  # from demo/fixtures/scene.json
shell_json="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
backup_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omakodi-demo"
backup="$backup_dir/shell.json.backup"

# A closed stderr (`| head`) must not kill the script before it restores.
trap '' PIPE
say() { printf 'demo: %s\n' "$*" >&2 2>/dev/null || true; }
die() { say "$*"; exit 1; }

# ---- preflight (nothing changes before the traps are set) ---------------------
[[ -n ${OMAKODI_CONFIG:-} && -n ${OMAKODI_DEMO_DIR:-} ]] ||
  die "run it inside demo/run: demo/run -- demo/screenshot"
[[ $OMAKODI_CONFIG =~ ^[A-Za-z0-9/._-]+$ ]] || die "unexpected OMAKODI_CONFIG path"
for cmd in hyprctl jq grim cmp quickshell omarchy-shell omarchy-restart-shell omarchy-launch-shell \
  omarchy-hyprland-session-locked; do
  command -v "$cmd" >/dev/null || die "missing command: $cmd"
done
omarchy-hyprland-session-locked && die "the session is locked"
[[ -f $shell_json ]] || die "no $shell_json"
jq -e '.bar.layout' "$shell_json" >/dev/null || die "$shell_json has no bar layout"
[[ -e $backup ]] && die "a backup from an interrupted demo is still at $backup; restore or remove it first"
monitors="$(hyprctl monitors -j)"
[[ $(jq length <<<"$monitors") -ge 1 ]] || die "no monitor"
monitor="$(jq -r '[.[] | select(.focused)][0] // .[0]' <<<"$monitors")"
[[ $(jq -r .transform <<<"$monitor") == 0 ]] || die "the focused monitor is rotated"
mon_name="$(jq -r .name <<<"$monitor")"
mon_w="$(jq -r '(.width / .scale) | floor' <<<"$monitor")"
old_ws="$(jq -r .activeWorkspace.id <<<"$monitor")"
empty_ws="$(hyprctl workspaces -j | jq -r '[.[] | select(.windows > 0) | .id] as $busy
  | [range(10; 0; -1) | select(. as $i | $busy | index($i) | not)][0] // empty')"
[[ -n $empty_ws ]] || die "no empty workspace among 1-10"
session_omarchy_path="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^OMARCHY_PATH=//p' | tail -n 1)"
shell_dir="${session_omarchy_path:-$OMARCHY_PATH}/shell"
[[ -f $shell_dir/shell.qml ]] || die "Omarchy shell config not found: $shell_dir"

ipc() { OMARCHY_SHELL_IPC_TIMEOUT=1s omarchy-shell "$@" 2>/dev/null; }

# Stop the running shell, as omarchy-restart-shell does.
stop_shell() {
  while timeout 30 quickshell kill -p "$shell_dir" --any-display >/dev/null 2>&1; do :; done
  local deadline=$((SECONDS + 30))
  while ((SECONDS < deadline)) && quickshell list -a -j 2>/dev/null |
    jq -e --arg dir "$shell_dir/" 'any(.[]; .config_path | startswith($dir))' >/dev/null 2>&1; do
    sleep 0.1
  done
}

wait_for_shell() {
  local deadline=$((SECONDS + 60))
  until ipc shell ping >/dev/null; do
    ((SECONDS < deadline)) || return 1
    sleep 0.2
  done
}

daemon_config() {  # OMAKODI_CONFIG of the shell's omakodi daemon, or "unset"
  local pid
  pid="$(pgrep -n -f "$plugin/bin/omakodi daemon" || true)"
  [[ -n $pid ]] || { echo "no daemon"; return; }
  tr '\0' '\n' <"/proc/$pid/environ" | sed -n 's/^OMAKODI_CONFIG=//p' | grep . || echo unset
}

# ---- restore -------------------------------------------------------------------
changed_config=0
changed_shell=0
changed_ws=0
restore() {
  local status=$? failed=0
  trap - EXIT
  trap '' INT TERM HUP  # finish restoring first
  set +e
  ipc "$plugin" closeRemote >/dev/null || true
  if ((changed_config)); then
    if cp -p "$backup" "$shell_json.omakodi-demo.tmp" && mv -f "$shell_json.omakodi-demo.tmp" "$shell_json" &&
      cmp -s "$backup" "$shell_json"; then
      say "restored $shell_json"
    else
      failed=1
      say "could not restore $shell_json; the original is at $backup"
    fi
  fi
  if ((changed_ws)); then
    hyprctl dispatch "hl.dsp.focus({ workspace = \"$old_ws\" })" >/dev/null
  fi
  if ((changed_shell)); then
    if omarchy-restart-shell >/dev/null 2>&1; then
      local cfg deadline=$((SECONDS + 20))
      while cfg="$(daemon_config)"; [[ $cfg == "no daemon" ]] && ((SECONDS < deadline)); do sleep 0.5; done
      [[ $cfg == "$OMAKODI_CONFIG" ]] && { failed=1; cfg="$cfg (still the demo config!)"; }
      say "shell restarted normally; omakodi daemon config: $cfg"
    else
      failed=1
      say "omarchy-restart-shell failed; run it yourself"
    fi
  fi
  if ((failed == 0)) && ((changed_config)); then
    rm -f "$backup"
    rmdir "$backup_dir" 2>/dev/null || true
  fi
  ((failed)) && exit 1
  exit "$status"
}
trap restore EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# ---- demo shell ------------------------------------------------------------------
mkdir -p "$backup_dir"
chmod 700 "$backup_dir"
cp -p "$shell_json" "$backup"
cmp -s "$shell_json" "$backup" || die "backup of $shell_json failed"
changed_config=1
jq '.bar.layout = {
      left: [{id: "omarchy.menu"}, {id: "omarchy.workspaces"}],
      center: [{id: "omarchy.clock", format: "dddd HH:mm"}],
      centerEnd: [{id: $plugin, maxTitleLength: 24}],
      right: [{id: "omarchy.audio"}, {id: "omarchy.power"}]
    }' --arg plugin "$plugin" "$backup" >"$shell_json.omakodi-demo.tmp"
chmod 600 "$shell_json.omakodi-demo.tmp"
mv -f "$shell_json.omakodi-demo.tmp" "$shell_json"
say "demo bar layout in place; restarting the shell against the fake Kodi"

changed_shell=1
stop_shell
hyprctl dispatch "hl.dsp.exec_cmd(\"env OMAKODI_CONFIG=$OMAKODI_CONFIG omarchy-launch-shell\")" >/dev/null
wait_for_shell || die "the demo shell did not start"

# Ready when the shell's own status says the fake's title (the real Kodi
# never plays it), and the daemon reads the fake's config.
deadline=$((SECONDS + 60))
until [[ $(ipc "$plugin" status | jq -r '.playing.title // empty' 2>/dev/null) == "$title" ]]; do
  ((SECONDS < deadline)) || die "the shell never showed the demo title"
  sleep 0.5
done
[[ $(daemon_config) == "$OMAKODI_CONFIG" ]] || die "the omakodi daemon is not using the demo config"
say "shell shows \"$title\" from the fake Kodi"

changed_ws=1
hyprctl dispatch "hl.dsp.focus({ workspace = \"$empty_ws\" })" >/dev/null
[[ $(ipc "$plugin" openRemote) == ok ]] || die "openRemote failed"
sleep 1.5  # the panel's open animation and the first state paint

# The clock, the Kodi widget beside it and the remote centred below the bar.
crop_w=560
crop_h=460
crop_x=$(((mon_w - crop_w) / 2))
if [[ -n ${OMAKODI_DEMO_FULL:-} ]]; then  # the whole monitor too, for checking the crop
  grim -o "$mon_name" "$OMAKODI_DEMO_FULL"
fi
grim -g "$crop_x,0 ${crop_w}x${crop_h}" "$out"
say "captured $out (${crop_w}x${crop_h} logical px at x=$crop_x on $mon_name)"
